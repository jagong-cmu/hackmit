.gstack/
.claude/

# iOS — Brownmellon.xcodeproj is generated by `xcodegen generate` from
# ios/project.yml. Don't commit it: with 3 people in separate worktrees,
# a hand-edited/regenerated .xcodeproj is exactly the kind of file that
# conflicts badly in git. Regenerate locally instead.
ios/*.xcodeproj/
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/DerivedData/

# backend
backend/node_modules/
backend/.env
backend/.vercel/

# macOS
.DS_Store
